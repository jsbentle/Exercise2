<!DOCTYPE job-posting
  [<!ELEMENT job-posting (
    <!ELEMENT posting-information (job-details, duties, qualifications)>
      <!ELEMENT job-details (list)>
        <!ELEMENT list (item)*>
        <!ELEMENT item (#PCDATA | posting-number | internal-recruitment | working-title | hiring-range | work-schedule | job-location | department)*>
          <!ELEMENT posting-number (#PCDATA)>
          <!ELEMENT internal-recruitment (#PCDATA)>
          <!ELEMENT working-title (#PCDATA)>
          <!ELEMENT hiring-range (#PCDATA)>
          <!ELEMENT work-schedule (#PCDATA)>
          <!ELEMENT job-location (#PCDATA)>
          <!ELEMENT department (#PCDATA)>
      <!ELEMENT duties (list 2)>
        <!ELEMENT list 2 (item2)*>
        <!ELEMENT item2 (#PCDATA)>
    <!ELEMENT qualifications (education, required, preferred, licences)>
      <!ELEMENT education (hs | bs | mams | phd)>
        <!ELEMENT hs (#PCDATA)>
        <!ELEMENT bs (#PCDATA)>
        <!ELEMENT mams (#PCDATA)>
        <!ELEMENT phd (#PCDATA)>
    )
